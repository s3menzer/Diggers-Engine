# Linux-hosted MinGW cross toolchain: the Windows target is built with native
# Linux tools and no Windows compiler binary or Wine runtime is required.
# Debian's Trixie tag is intentionally movable; see README-windows.md.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    MINGW_TARGET=x86_64-w64-mingw32 \
    MINGW_THREAD_MODEL=posix \
    CC=x86_64-w64-mingw32-gcc-posix \
    CXX=x86_64-w64-mingw32-g++-posix \
    AR=x86_64-w64-mingw32-ar \
    RANLIB=x86_64-w64-mingw32-ranlib \
    WINDRES=x86_64-w64-mingw32-windres \
    CROSS_COMPILE=x86_64-w64-mingw32-

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        autoconf \
        automake \
        binutils-mingw-w64-x86-64 \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        g++-mingw-w64-x86-64-posix \
        gcc-mingw-w64-x86-64-posix \
        git \
        libtool \
        make \
        mingw-w64-x86-64-dev \
        nasm \
        ninja-build \
        patch \
        perl \
        pkg-config \
        python3 \
        tar \
        unzip \
        xz-utils \
        7zip \
    && ln -s "$(command -v 7z)" /usr/local/bin/7zz \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
CMD ["bash", "-i"]
